# Managix — example environment (safe to commit; contains NO secrets)
# Copy to .env and fill in values locally. .env is git-ignored.

# Supabase Postgres storage (optional). Leave blank for offline JSON file mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=

PORT=8787

# Browser login (Vite build-time). Same URL + ANON/publishable key as above.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Super-admin demo gate passcode override (default 246810, demo only).
# VITE_SA_PASSCODE=

# Production CORS allow-list, comma-separated. Dev default allows localhost.
# CORS_ORIGINS=https://your-shop-domain.com
